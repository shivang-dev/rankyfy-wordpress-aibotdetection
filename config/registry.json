{
  "schema": 1,
  "version": "2026.10.05.1",
  "updated": "2026-10-05",
  "_comment": "Canonical AI crawler registry. The same file is embedded in the RankyFy backend (contentai/src/aibotdetection/registry.json), which serves the live copy; the plugin ships this one as its offline fallback. patterns: case-insensitive literal user-agent substrings. robots_tokens: the names robots.txt groups use. verify.ranges: published IP-range files (JSON; any CIDR strings inside are used). verify.rdns: reverse-DNS host suffixes for forward-confirmed reverse DNS. verify.signature_hosts: Web Bot Auth (HTTP Message Signatures) Signature-Agent hosts; signed_only: recognised only by a valid signature. ip_only: the agent sends a normal browser user agent, so it can only be recognised by address. source: 'official' = checked against the operator's own documentation on verified_on; 'community' = no operator documentation, identified from public reports.",
  "categories": {
    "ai_training": "Collects content to train AI models",
    "ai_search": "Indexes pages so an AI assistant can find and cite them",
    "ai_user": "Fetches a page because a person asked an AI assistant something",
    "ai_agent": "An AI agent browsing on a person's behalf",
    "ai_other": "Other AI-related automated traffic",
    "search": "Classic search engine crawler",
    "seo": "SEO and marketing tool crawler",
    "social": "Link-preview fetcher for social networks and messengers",
    "monitor": "Uptime, feed or monitoring service"
  },
